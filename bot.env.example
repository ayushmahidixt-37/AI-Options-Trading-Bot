# Runtime paths for a Linux server. The service user must be able to write DATA_DIR.
DATA_DIR=/var/lib/ai-options-bot
DATABASE_PATH=/var/lib/ai-options-bot/paper.sqlite3
CREDENTIALS_PATH=/etc/ai-options-bot/credentials.env

# Structural safety controls. The current application accepts paper mode only.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTO_START=false

# Initial conservative paper-risk profile.
PAPER_STARTING_CAPITAL=100000
MAX_LOTS_PER_TRADE=1
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=3
MAX_LOSS_PER_TRADE=400
MAX_DAILY_NET_LOSS=1000
MAX_QUOTE_AGE_SECONDS=3
PAPER_SLIPPAGE_BPS=25
PAPER_FEE_PER_ORDER=20

TIMEZONE=Asia/Kolkata
ENTRY_START_IST=09:25
ENTRY_CUTOFF_IST=15:00
FORCE_EXIT_IST=15:20
